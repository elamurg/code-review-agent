#Copy to .env and replace the passwords. Hostnames are the compose service names.

#Neo4j. The community image only accepts "neo4j" as the initial user,
#and the password must be at least 8 characters.
NEO4J_USER=neo4j
NEO4J_PASSWORD=insert_password_here

NEO4J_URI=bolt://neo4j:7687

POSTGRES_USER=reviewer
POSTGRES_DB=reviewer_dev
POSTGRES_PASSWORD=insert_password_here

#Must match the three POSTGRES_ values above.
DATABASE_URL=postgresql://reviewer:insert_password_here@postgres:5432/reviewer_dev

REDIS_URL=redis://redis:6379/0
